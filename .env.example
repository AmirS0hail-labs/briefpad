# Local Docker Postgres (see docker-compose.yml). Port 5433 avoids clashing with a local Postgres on 5432.
DATABASE_URL="postgresql://briefpad:briefpad@localhost:5433/briefpad"
# Same as DATABASE_URL locally. On Neon, use the pooled URL above and the direct (non-pooler) URL here.
DIRECT_URL="postgresql://briefpad:briefpad@localhost:5433/briefpad"

# At least 32 characters. Generate a unique value for production (Vercel env).
SESSION_SECRET="replace-with-at-least-32-characters-long"
